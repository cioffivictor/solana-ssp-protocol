{
  "name": "quorumforge-viewer",
  "version": "0.1.0",
  "description": "A dependency-light council viewer that renders QuorumForge JSON reports as annotated ANSI console output or standalone HTML.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "qf-view": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "view": "node dist/cli.js",
    "test": "tsc -p tsconfig.json && node dist/render.test.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
